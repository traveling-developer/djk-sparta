{
  "name": "instagram-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env.local src/main.ts",
    "dry-run": "node --env-file=.env.local src/main.ts --dry-run",
    "draft": "node --env-file=.env.local src/main.ts --draft",
    "preview": "node src/preview.ts",
    "generate": "node src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/opentype.js": "^1.3.10",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0"
  }
}
