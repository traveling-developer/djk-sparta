{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss mit dem Worker-Namen in Cloudflare (Workers Builds) übereinstimmen.
  "name": "djk-sparta-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Keine öffentliche URL — der Worker reagiert nur auf Cron Triggers.
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": {
    // Cron-Strings (UTC) müssen exakt zu JOBS in src/index.ts passen.
    // Wochentag als Name: bei Cloudflare ist 1 = Sonntag (nicht Montag wie bei Unix-cron)!
    "crons": ["30 14 * * *", "30 16 * * *", "0 8 * * MON", "0 2 * * *"],
  },
  "vars": { "DRY_RUN": "" },
  // Secret GITHUB_TOKEN: npx wrangler secret put GITHUB_TOKEN
}
